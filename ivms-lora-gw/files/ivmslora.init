#!/bin/sh /etc/rc.common
# IVMS LoRa gateway (E32 on USB) - see /usr/bin/ivms-lora-gw
START=99
USE_PROCD=1

start_service() {
	[ "$(uci -q get ivmslora.general.enabled)" = "1" ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/ivms-lora-gw
	procd_set_param respawn 3600 10 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger ivmslora
}
